{
  "contract": "workspace-directory",
  "version": 5,
  "owner": "myClinicLicenseAuthority",
  "consumers": [
    "myClinic",
    "tenant-schema"
  ],
  "roles": {
    "workspace_member": [
      "admin",
      "doctor",
      "staff"
    ],
    "central_auth_metadata": [
      "admin",
      "clinic_user"
    ]
  },
  "tenant": {
    "schema_version": 22,
    "members_table": "tenant_members",
    "member_helper": "is_tenant_member",
    "meta_table": "tenant_meta",
    "gate_policy_suffix": "tenant_gate",
    "admit_rpc": "tenant_admit_member",
    "role_map": {
      "admin": "owner",
      "doctor": "doctor",
      "staff": "frontdesk"
    },
    "slug_claim": "tenant_slug",
    "slug_pattern": "^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$",
    "url_pattern": "^https://[a-z0-9-]+\\.supabase\\.co/?$",
    "forbidden_key_pattern": "service_role|sb_secret",
    "rest_root": "/rest/v1/",
    "version_probe": {
      "rpc": "app_schema_version",
      "method": "POST",
      "path": "/rest/v1/rpc/app_schema_version",
      "anon_executable": true,
      "returns": "the tenant schema version as a bare integer"
    },
    "clinical_probe_table": "patients"
  },
  "auth": {
    "issuer": "myclinic-license-authority",
    "tenant_token_ttl_seconds": 900,
    "offline_lease_ttl_seconds": 604800,
    "claims": [
      "iss",
      "sub",
      "aud",
      "role",
      "workspace_id",
      "tenant_slug",
      "tenant_schema_version",
      "tier",
      "kid",
      "iat",
      "exp"
    ]
  },
  "rpc": {
    "anon_only": [
      "sync_clinic_subscription",
      "public_workspace_by_slug"
    ],
    "authenticated_discovery": "my_workspaces",
    "sync_response_workspace": {
      "key": "workspace",
      "fields": [
        "slug",
        "supabase_url",
        "supabase_anon_key",
        "tenant_schema_version"
      ],
      "null_when": "no workspace linked, or linked workspace is_inactive",
      "carrier": "sync_clinic_subscription (the anon subscription-sync RPC)"
    },
    "public_booking_directory": {
      "rpc": "public_workspace_by_slug",
      "caller": "anon",
      "argument": "p_slug",
      "returns": [
        "clinic_name",
        "slug",
        "supabase_url",
        "supabase_anon_key"
      ],
      "filter": "is_active = true",
      "fail_closed": "an unknown or inactive slug returns no rows",
      "purpose": "D4-a: the no-session public booking page (/#/book/<slug>) resolves the tenant project, then calls that tenant's own anon-safe SECURITY DEFINER booking RPCs. The anon key is publishable (C1); the tenant's RLS is the boundary."
    }
  },
  "keep_warm": {
    "reason": "Supabase free tier pauses a project after 7 days without activity",
    "pause_days": 7,
    "target_days": 5,
    "cron_schedule": "17 */6 * * *",
    "probe_path": "/rest/v1/",
    "stamp_column": "keep_warm_at"
  },
  "storage_keys": {
    "active_workspace_session": "opd.active.workspace",
    "last_workspace_local": "opd.last.workspace",
    "admin_auth": "opd.admin.master.auth",
    "clinic_auth": "opd.clinic.master.auth",
    "offline_namespace": "myclinic.<kind>.v3.<slug>.<userId>"
  },
  "pages": {
    "clinic_app": "/",
    "admin_console": "/admin/",
    "service_worker_scopes": {
      "clinic_app": "/",
      "admin_console": "/admin/"
    }
  },
  "env": {
    "clinic_app": [
      "VITE_CENTRAL_SUPABASE_URL",
      "VITE_CENTRAL_SUPABASE_ANON_KEY"
    ],
    "forbidden_env_pattern": "VITE_.*(TENANT|CLINIC_.{0,10}SUPABASE).*"
  }
}
