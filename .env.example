# Copy to .env.local for the Control Room Web App (Vite).
# ONLY public publishable/anon keys belong in VITE_ variables.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or LICENSE_PRIVATE_KEY in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# On-Premises Node Validator variables (used by `npm run start:validator`, never bundled into Vite):
LICENSE_VERIFY_URL=https://YOUR-PROJECT.supabase.co/functions/v1/verify-license
SUPABASE_ANON_KEY=your-authority-publishable-or-anon-key
LICENSE_KEY=
LICENSE_PUBLIC_KEY=
LICENSE_SYNC_CRON=0 */6 * * *
PORT=4000
CORS_ORIGIN=http://localhost:5174
MYCLINIC_DIST_DIR=
