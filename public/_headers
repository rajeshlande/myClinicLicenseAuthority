# Cloudflare/Netlify-style header manifest. GitHub Pages ignores this file,
# so the CSP lives in index.html's meta tag; server/node-host.mjs applies the
# same hardening for on-prem hosts. Kept so a CDN deploy inherits it for free.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
/assets/*
  Cache-Control: public, max-age=31536000, immutable
